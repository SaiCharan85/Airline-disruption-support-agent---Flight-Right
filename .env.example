# Copy to .env and fill in. .env is git-ignored; never commit real values.
# Project rule: free resources only. Every service below has a free tier or is self-hosted.

# ---- LLM providers (free tiers + local fallback) ----
# Free key from console.groq.com > API Keys
GROQ_API_KEY=
# Free key from aistudio.google.com > Get API key
GOOGLE_API_KEY=
# Local Ollama server (last fallback; no key needed)
OLLAMA_BASE_URL=http://localhost:11434

# ---- Tracing: LangSmith (free Developer tier) ----
# Set to "true" to send traces
LANGSMITH_TRACING=false
# From smith.langchain.com > Settings > API Keys
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=flightright-agent

# ---- Ops API (Step 9): generate random values, e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"
OPS_API_KEY=
OPS_ADMIN_KEY=

# ---- n8n (Step 10, self-hosted community edition) ----
# Shared secret for HMAC-signed webhooks between the API and n8n (same value in n8n's credentials store)
N8N_HMAC_SECRET=
# Where the API sends signed events: localhost when the API runs on the host, http://n8n:5678/... in compose
N8N_EVENTS_WEBHOOK_URL=http://localhost:5678/webhook/flightright-events
# How n8n reaches the API (default: the host, from inside the container)
FLIGHTRIGHT_API_URL=http://host.docker.internal:8000
# Links in ticket notices
FLIGHTRIGHT_CONSOLE_URL=http://localhost:5173
# Test stack only: shorten every handoff SLA wait to this many seconds (scripts/test_n8n_flows.py)
SLA_SECONDS_OVERRIDE=
