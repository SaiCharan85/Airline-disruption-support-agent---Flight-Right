        "jsonBody": "={{ JSON.stringify({ kind: 'digest', ticket_id: null, channel: 'log', text: $json.text }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    }
