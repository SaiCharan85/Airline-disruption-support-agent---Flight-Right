    {
      "id": "900ef93c-f8b7-570a-964c-ac53831e8e7c",
      "name": "Format digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Formatting only: turn the API's numbers into a short digest; missing parts become warnings.\nconst warn = [];\nconst get = (name) => {\n  const items = $(name).all().map(i => i.json);\n  if (items.some(j => j.error)) { warn.push(`${name}: unavailable`); return null; }\n  return items;\n};\nconst m = (get('Judge metrics (24 h)') || [])[0];\nconst fair = (get('Fairness') || [])[0];\nconst open = (get('Open handoffs') || []).filter(j => j.ticket_id);\nconst esc = (get('Escalated handoffs') || []).filter(j => j.ticket_id);\nconst lines = ['Flightright daily digest'];\nif (m) {\n  lines.push(`Judgements (24 h): ${m.judgements}`);\n  for (const [tier, d] of Object.entries(m.decisions_by_tier || {})) {\n    const total = Object.values(d).reduce((a, b) => a + b, 0);\n    lines.push(`  ${tier}: ${d.approve || 0}/${total} approved, ${d.revise || 0} revised, ${d.handoff || 0} handed off`);\n  }\n  const pct = (x) => x == null ? 'n/a' : (100 * x).toFixed(0) + '%';\n  lines.push(`Panel disagreement: ${pct(m.panel_disagreement_rate)}; judge unavailable: ${pct(m.judge_unavailable_rate)}; p95 latency: ${m.latency_ms_p95 ?? 'n/a'} ms`);\n  const q = Object.entries(m.quota_today || {}).map(([k, v]) => `${k} ${v.requests}/${v.rpd_limit ?? '?'}`);\n  lines.push('Free-tier usage today: ' + (q.length ? q.join(', ') : 'none'));\n}\nlines.push(`Open handoffs: ${open.length} (SLA breached: ${open.filter(h => h.sla_breached).length}); escalated: ${esc.length}`);\nif (fair) lines.push(fair.available ? 'Fairness: counterfactual gaps available in the console' : 'Fairness: not computed yet');\nif (warn.length) lines.push('Warnings: ' + warn.join('; '));\nreturn [{ json: { text: lines.join('\\n') } }];\n"
      }
    },
    {
      "id": "54a9b541-1e15-5d36-8a34-692ccfb4c4c6",
      "name": "Send digest",
      "type": "n8n-nodes-base.httpRequest",
