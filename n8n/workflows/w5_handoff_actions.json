    {
      "id": "6d2b057f-bcb3-5e1d-93f4-f62df9de2f7e",
      "name": "Normalize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Mapping only: the form and the webhook send different shapes.\nreturn $input.all().map(item => {\n  const j = item.json;\n  const b = j.body || {};\n  const fromForm = 'Ticket ID' in j;\n  const pick = (formKey, key) => fromForm ? j[formKey] : b[key];\n  const action = String(pick('Action', 'action') || '').toLowerCase();\n  const paid = pick('Compensation paid (EUR)', 'compensation_paid');\n  const out = {\n    source: fromForm ? 'form' : 'webhook',\n    ticket_id: String(pick('Ticket ID', 'ticket_id') || '').trim(),\n    action,\n    decision: String(pick('Decision', 'decision') || '').trim(),\n    notes: String(pick('Notes', 'notes') || ''),\n    compensation_paid: paid === '' || paid == null ? null : Number(paid),\n  };\n  const errors = [];\n  if (!out.ticket_id) errors.push('Ticket ID is required');\n  if (!['acknowledge', 'resolve'].includes(action)) errors.push('Action must be acknowledge or resolve');\n  if (action === 'resolve' && !out.decision) errors.push('Decision is required to resolve a ticket');\n  out.error = errors.join('; ');\n  return { json: out };\n});\n"
      }
    },
