    },
    {
      "id": "390394d7-a644-5fdf-b314-c0f393c271a0",
      "name": "Resolve ticket",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        100
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.FLIGHTRIGHT_API_URL }}/ops/handoffs/{{ $json.ticket_id }}/resolve",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.OPS_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ decision: $json.decision, notes: $json.notes, compensation_paid: $json.compensation_paid }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "1e2d11fc-fc60-5382-8684-0ee009b7202c",
      "name": "Confirm",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Formatting only: confirm back to the person (API errors are shown as-is).\nconst req = $('Normalize').first().json;\nconst r = $input.first().json;\nconst ok = !r.error && r.status;\n// HTTP errors arrive as '<code> - \"<problem+json>\"'; show the problem title.\nconst apiError = () => {\n  const raw = String((r.error && r.error.message) || '');\n  try {\n    let p = JSON.parse(raw.slice(raw.indexOf(' - ') + 3));\n    if (typeof p === 'string') p = JSON.parse(p);\n    return p.title || raw;\n  } catch (e) { return raw || 'unknown error'; }\n};\nconst message = req.error\n  ? `Not sent: ${req.error}`\n  : ok\n    ? `Ticket ${r.ticket_id} is now ${r.status}.`\n    : `The API refused this action: ${apiError()}`;\nreturn [{ json: { ok: Boolean(ok) && !req.error, message, ticket_id: req.ticket_id, status: ok ? r.status : null } }];\n"
      }
    }
