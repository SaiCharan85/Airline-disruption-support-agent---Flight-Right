            {
              "id": "c1968e09-9e0e-5bbb-99e7-714e555b679b",
              "leftValue": "={{ $json.conversation_id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      }
    },
    {
      "id": "860da6a9-3a3a-5422-93ed-561d67a9d1dd",
      "name": "Create conversation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        360
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.FLIGHTRIGHT_API_URL }}/conversations",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ channel: $json.channel, booking_ref: $json.booking_ref }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "id": "90f026dc-455a-5fd7-9525-f1020537038e",
      "name": "Remember conversation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        360
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const store = $getWorkflowStaticData('global');\nstore.users = store.users || {};\nconst msg = $('Map user to conversation').first().json;\nconst cid = $input.first().json.conversation_id;\nstore.users[msg.user_id] = cid;\nreturn [{ json: { ...msg, conversation_id: cid } }];\n"
      }
    },
    {
      "id": "5536d1c1-46a6-5bba-9eaa-445ea0bc7dcd",
      "name": "Send to agent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.FLIGHTRIGHT_API_URL }}/conversations/{{ $json.conversation_id }}/messages",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: $json.text, idempotency_key: $json.message_id }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "id": "53005b7a-0f6f-5902-b38d-7bd8b08e7299",
      "name": "Reply",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        1540,
        100
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ reply_text: $json.reply_text, status: $json.status, ticket_id: $json.ticket_id, duplicate: $json.duplicate, conversation_id: ($('Remember conversation').isExecuted ? $('Remember conversation').first().json.conversation_id : $('Map user to conversation').first().json.conversation_id) }) }}",
        "options": {}
      }
    },
    {
      "id": "78d3ef92-0a30-5936-89c2-c5e9183cec53",
      "name": "Log delivery failure",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        320
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.FLIGHTRIGHT_API_URL }}/ops/notifications",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.OPS_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ kind: 'alert', ticket_id: null, channel: 'log', text: 'W1: the agent API did not answer after 3 tries; holding message sent to ' + $('Map user to conversation').first().json.user_id }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "fd9b4928-3c5a-57d3-b0be-777c036284df",
      "name": "Holding message",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        1760,
        320
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ reply_text: 'Thanks for your message. We are having a technical problem right now; a colleague will get back to you shortly.', status: 'holding', ticket_id: null }) }}",
        "options": {
          "responseCode": 202
        }
      }
    }
  ],
