    {
      "id": "774407b8-ad28-5f70-a69c-6d6c55b20648",
      "name": "Map user to conversation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Mapping only: channel user -> conversation_id (kept in this workflow's static data).\nconst store = $getWorkflowStaticData('global');\nstore.users = store.users || {};\nreturn $input.all().map(item => {\n  const b = item.json.body || {};\n  const missing = ['user_id', 'text', 'message_id'].filter(k => !b[k]);\n  return { json: {\n    user_id: String(b.user_id || ''),\n    text: String(b.text || ''),\n    message_id: String(b.message_id || ''),\n    channel: String(b.channel || 'webhook'),\n    booking_ref: b.booking_ref || null,\n    conversation_id: store.users[String(b.user_id)] || '',\n    invalid: missing.length ? `missing field(s): ${missing.join(', ')}` : '',\n  } };\n});\n"
      }
    },
    {
      "id": "c97b8aa2-f6c9-5198-b2fc-39c795b90c87",
      "name": "Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "d00f202f-c222-5a01-89b5-0dcdc2ca1c80",
              "leftValue": "={{ $json.invalid }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "empty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      }
    },
    {
      "id": "638734a4-d3c1-51b0-91c5-8f1cdfca085d",
      "name": "Reject",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        660,
        480
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ error: $json.invalid }) }}",
        "options": {
          "responseCode": 400
        }
      }
    },
    {
      "id": "f7315df2-8fff-59b6-bf4a-d1dd52bde11e",
