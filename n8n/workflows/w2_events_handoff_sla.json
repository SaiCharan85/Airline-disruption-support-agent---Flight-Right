    {
      "id": "8502a875-a8ce-5e84-8669-9f44b9582df4",
      "name": "Dedupe alert (1 h)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// W4: route by type and drop repeats of the same alert within an hour (formatting only).\nconst store = $getWorkflowStaticData('global');\nstore.alerts = store.alerts || {};\nconst now = Date.now();\nconst out = [];\nfor (const item of $input.all()) {\n  const p = item.json.payload || {};\n  const key = item.json.event + ':' + (p.metric || p.conversation_id || '');\n  if (store.alerts[key] && now - store.alerts[key] < 3600 * 1000) continue;\n  store.alerts[key] = now;\n  const text = item.json.event === 'metrics.threshold_breached'\n    ? `Judge monitor: ${p.metric} is ${Number(p.value).toFixed(2)} (limit ${p.limit}) over the last hour.`\n    : `Prompt-injection attempt blocked in conversation ${p.conversation_id}.`;\n  out.push({ json: { kind: item.json.event, text } });\n}\nreturn out;\n"
      }
    },
