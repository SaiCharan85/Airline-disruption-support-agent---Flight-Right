    {
      "id": "5233116e-051e-59c5-9e98-1530a676690e",
      "name": "Verify signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Signature verification only (SPEC 7.4): HMAC-SHA256 over timestamp + raw body, 5-minute window,\n// event_id de-duplication. No business logic here.\nconst crypto = require('crypto');\nconst secret = $env.N8N_HMAC_SECRET || '';\nconst store = $getWorkflowStaticData('global');\nstore.seen = store.seen || [];\nconst out = [];\nconst items = $input.all();\nfor (let i = 0; i < items.length; i++) {\n  const item = items[i];\n  const h = item.json.headers || {};\n  const ts = String(h['x-timestamp'] || '');\n  const sig = String(h['x-signature'] || '');\n  let raw;\n  try { raw = await this.helpers.getBinaryDataBuffer(i, 'data'); }\n  catch (e) { raw = Buffer.from((item.binary && item.binary.data && item.binary.data.data) || '', 'base64'); }\n  const expected = 'sha256=' + crypto.createHmac('sha256', secret)\n    .update(Buffer.concat([Buffer.from(ts), raw])).digest('hex');\n  const age = Math.abs(Date.now() / 1000 - Number(ts));\n  let reason = '';\n  if (!secret) reason = 'N8N_HMAC_SECRET is not set';\n  else if (!ts || !Number.isFinite(age) || age > 300) reason = 'timestamp missing or outside the 5-minute window';\n  else if (sig.length !== expected.length || !crypto.timingSafeEqual(Buffer.from(sig), Buffer.from(expected))) reason = 'bad signature';\n  let envelope = {};\n  if (!reason) {\n    try { envelope = JSON.parse(raw.toString('utf8')); } catch (e) { reason = 'body is not JSON'; }\n  }\n  if (!reason && store.seen.includes(envelope.event_id)) reason = 'duplicate event_id';\n  if (!reason) { store.seen.push(envelope.event_id); store.seen = store.seen.slice(-500); }\n  out.push({ json: {\n    valid: !reason, reason,\n    event_id: envelope.event_id || h['x-event-id'] || null,\n    event: envelope.event || null,\n    payload: envelope.payload || {},\n  } });\n}\nreturn out;\n"
      }
    },
