{
  "id": "FRw4AlertPoll001",
  "name": "W4 Threshold alert poll",
  "active": true,
  "nodes": [
    {
      "id": "2abd1b45-9287-5ec4-8b27-1c28dacb2b94",
      "name": "Every 15 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        200
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      }
    },
    {
      "id": "4bbfe5c4-25fd-566e-a9cb-6cf708c194ef",
      "name": "Check thresholds",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.FLIGHTRIGHT_API_URL }}/ops/alerts/check",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.OPS_API_KEY }}"
            }
          ]
        },
        "options": {
          "timeout": 120000
        }
      },
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    }
  ],
  "connections": {
    "Every 15 minutes": {
      "main": [
        [
          {
            "node": "Check thresholds",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true
  },
  "pinData": {},
  "tags": []
}
